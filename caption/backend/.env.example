# Server Configuration
PORT=5000
NODE_ENV=development

# -----------------------------------------------------------------------------
# AI API KEYS (Required for Phase 2: Audio Speech-to-Text & Phase 3)
# -----------------------------------------------------------------------------

# Primary STT Provider: Groq Whisper API (Recommended)
GROQ_API_KEY=your_groq_api_key_here

# Alternative STT Provider: OpenAI Whisper API
OPENAI_API_KEY=your_openai_api_key_here

# Optional LLM Provider: Google Gemini API (Filler word removal)
GEMINI_API_KEY=your_gemini_api_key_here
