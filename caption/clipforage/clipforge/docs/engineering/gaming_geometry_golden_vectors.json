{
  "version": "1.0.0",
  "name": "GamingGeometryGoldenVectors",
  "description": "Authoritative cross-language golden vectors for ClipForge dual-region gaming layout geometry and preview-to-FFmpeg parity.",
  "invariants": {
    "normalized_bounds": "[0.0, 1.0]",
    "min_roi_size": 0.05,
    "canvas_aspect_ratio": "9:16",
    "default_canvas_width": 1080,
    "default_canvas_height": 1920,
    "yuv420p_even_pixels": "coord % 2 == 0",
    "even_pixel_formula": "floor((coord * dim) / 2) * 2",
    "zero_caption_invariant": "-sn flag, no subtitle filters"
  },
  "vectors": [
