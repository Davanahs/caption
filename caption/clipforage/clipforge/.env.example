# App Data Dir: C:\Users\Chinmaygouda\.gemini\antigravity
# ─── ClipForge Environment Configuration ───────────────────────────────────

# ── App ──────────────────────────────────────────────────────────────────────
DEBUG=true

# ── Database ─────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://clipforge_user:clipforge_password@localhost:5432/clipforge
SYNC_DATABASE_URL=postgresql+psycopg2://clipforge_user:clipforge_password@localhost:5432/clipforge

# Connection Pooling
DB_POOL_SIZE=20
DB_MAX_OVERFLOW=10
DB_POOL_TIMEOUT=30

# ── Redis (required for background jobs) ────────────────────────────────────
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1

# ── YouTube OAuth (follow SETUP_GUIDE.md to get these) ──────────────────────
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
YOUTUBE_REFRESH_TOKEN=
YOUTUBE_TOKEN_FILE=youtube_token.json

# ── Cloud AI / LLM & Audio Providers ────────────────────────────────────────
GROQ_API_KEY=
GROQ_MODEL=whisper-large-v3-turbo
OPENROUTER_API_KEY=
OPENROUTER_MODEL=deepseek/deepseek-r1:free
NVIDIA_API_KEY=
NVIDIA_MODEL=meta/llama-3.1-405b-instruct

# ── Whisper (local, free) ───────────────────────────────────────────────────
# Options: tiny (fastest) | base | small | medium | large (most accurate)
WHISPER_MODEL=base

# ── Clip Settings ────────────────────────────────────────────────────────────
MIN_CLIP_DURATION=15
MAX_CLIP_DURATION=60
CLIPS_PER_VIDEO=5
REFRAME_MODE=blur

# ── Channel Automation ───────────────────────────────────────────────────────
CHANNEL_CHECK_INTERVAL_MINUTES=30
